# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string dari Neon.tech
# CATATAN: Database sudah di-share antar developer
# Gunakan DATABASE_URL yang sama dengan tim
DATABASE_URL="tanya zikri codenya"

# ============================================
# NEXTAUTH
# ============================================
# Secret key untuk NextAuth.js (gunakan nilai random untuk production)
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# URL aplikasi (sesuaikan dengan environment)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# ============================================
# CLOUDINARY
# ============================================
# Credentials untuk upload gambar
# Daftar di: https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# RESEND (Email Service)
# ============================================
# API Key untuk mengirim email notifikasi
# Daftar di: https://resend.com
RESEND_API_KEY="re_your_api_key_here"

# (Optional) Custom FROM email untuk production
# Default: PantauKota <onboarding@resend.dev>
# Production: PantauKota <noreply@yourdomain.com>
RESEND_FROM_EMAIL="PantauKota <onboarding@resend.dev>"

# (Optional) Test email untuk development
# Jika diset, semua email di development akan dikirim ke email ini
# Berguna untuk testing tanpa mengirim ke user sebenarnya
RESEND_TEST_EMAIL="your-test-email@example.com"

# ============================================
# NODE ENVIRONMENT
# ============================================
# development | production | test
NODE_ENV="development"
